# =====================================================
# Alumni Influencers API - Environment Variables
# =====================================================

# Copy this file to .env and fill in your values

# --------- SERVER ---------
PORT=3000
NODE_ENV=development

# --------- DATABASE ---------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=alumni_platform
DB_PORT=3306

# --------- EMAIL (SMTP) ---------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@eastminster.ac.uk

# --------- JWT & SECURITY ---------
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# --------- URLS ---------
APP_URL=http://localhost:3000
CI_APP_URL=http://localhost:8080

# --------- ALLOWED DOMAINS ---------
ALLOWED_DOMAINS=eastminster.ac.uk,westminster.ac.uk,my.westminster.ac.uk,iit.ac.lk